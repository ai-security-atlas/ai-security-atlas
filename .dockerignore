# Version control
.git
.gitignore

# Node / Python envs (reinstalled in-image)
node_modules
.venv

# Generated build output (regenerated by the compiler in-image)
public
resources
static/assets/dist
static/data
data
content/nodes
content/nodetabs
content/sources
content/views
content/graph
static/labs
content/labs
.hugo_build.lock

# Tooling / local
.playwright-mcp
test-results
*.png
!static/og.png
.env
.env.*
.DS_Store
**/.DS_Store
**/node_modules
**/__pycache__
**/*.pyc
.claude
.gemini

# Docker
Dockerfile
.dockerignore

# Labs: the site image needs only each lab's README (front matter) and the
# explainers (published under /labs/); lab code, work/ and payloads stay out.
labs/*
!labs/*/README.md
!labs/learning-path.yaml
!labs/_explainer
!labs/*/explainer
labs/_explainer/test
