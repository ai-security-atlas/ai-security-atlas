.PHONY: help install update build build-prod serve docker clean

# ==============================================================================
# Tooling
# ==============================================================================
UV           := uv
NPM          := npm
HUGO         := hugo
DOCKER       := docker
HUGO_PORT    := 1313
HUGO_ARGS    ?=
DOCKER_IMAGE := ai-security-atlas
DOCKER_TAG   := latest

# Generated/derived paths (safe to delete; regenerated by the compiler)
GENERATED := public static/assets/dist static/data data \
             content/nodes content/sources content/views content/graph \
             .hugo_build.lock resources

help: ## Show available commands
	@echo "AI Security Atlas — make targets:"
	@echo "  make install     Install Node + Python dependencies"
	@echo "  make serve       Run the dev server (compiler + Vite + Hugo) on :$(HUGO_PORT)"
	@echo "  make build       Build the static site for local preview"
	@echo "  make build-prod  Build with the production baseURL (for deploy)"
	@echo "  make docker      Build the container image ($(DOCKER_IMAGE):$(DOCKER_TAG))"
	@echo "  make clean       Remove generated files and build artifacts"

install: ## Install Node and Python dependencies
	@echo "==> Installing Node dependencies"
	$(NPM) ci
	@echo "==> Installing Python dependencies"
	$(UV) sync

# Compile the seed -> atlas + Hugo content, and bundle the SPA assets.
update: ## Regenerate content from the seed and build JS/CSS assets
	$(UV) run python json2hugo.py
	$(NPM) run build

build: update ## Build the static site (validate + Hugo + Pagefind)
	$(HUGO) --minify $(HUGO_ARGS)
	npx --yes pagefind --site public

build-prod: ## Build the static site with the production baseURL
	$(MAKE) build HUGO_ARGS="--config hugo.toml,config.production.toml"

serve: update ## Start the Hugo dev server with live reload
	$(HUGO) server -D --bind 0.0.0.0 -p $(HUGO_PORT)

docker: ## Build the Docker image
	$(DOCKER) build -t $(DOCKER_IMAGE):$(DOCKER_TAG) .

clean: ## Remove generated files and build artifacts
	rm -rf $(GENERATED)
